PORT=8080
HOST=0.0.0.0
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
OWNER_SALT=OPTIONAL_STABLE_HEX_SALT
OWNER_PASSWORD_HASH=OPTIONAL_PRECOMPUTED_SCRYPT_HASH
DATA_FILE=./data.json
# FCM production
FCM_PROJECT_ID=your-firebase-project-id
# Firebase Admin SDK uses Google Application Default Credentials.
# Set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path on the server,
# or use workload identity on supported Google Cloud infrastructure.
